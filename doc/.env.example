# Copy to ./.env next to your copy of lilypond-toolkit.sample.sh (i.e. as
# .env in the score project's root) and adjust. Anything left commented
# out uses the entrypoint script's or the toolkit scripts' own default.

# Path to your local checkout of lilypond-toolkit.
TOOLKIT_HOME="$HOME/Documents/my-music-scores/lilypond-toolkit"

# Only needed if MuseScore/Muse Keys aren't at the default install paths.
# MSCORE="/Applications/MuseScore 4.app/Contents/MacOS/mscore"
# MUSESCORE_APP="/Applications/MuseScore 4.app"
# MUSE_KEYS_DIR="$HOME/Library/Application Support/Muse Hub/Downloads/Instruments/Muse Keys"
